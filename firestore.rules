rules_version = '2';

// Regras do banco do Radar de Vagas.
// - Cada pessoa lê e escreve só a própria ficha (users/{uid}) e os próprios dados (users/{uid}/dados/*).
// - O super admin (e-mail verificado abaixo) lê e altera tudo, e é o único que muda "bloqueado" e "papel".
// - Conta bloqueada não grava dados.
// - A própria pessoa pode apagar a ficha e os dados (Excluir minha conta, LGPD).
// - config/* (configuração da IA): todos que entraram leem; só o super admin altera.
// - erros/*: registro de erros do site; todos que entraram criam, só o super admin lê e apaga.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }
    function superAdmin() {
      return logado()
        && request.auth.token.email == "nascimentohebo2@gmail.com"
        && request.auth.token.email_verified == true;
    }
    function dono(uid) {
      return logado() && request.auth.uid == uid;
    }
    function naoBloqueado(uid) {
      return !exists(/databases/$(database)/documents/users/$(uid))
        || get(/databases/$(database)/documents/users/$(uid)).data.get("bloqueado", false) != true;
    }

    match /users/{uid} {
      allow read: if dono(uid) || superAdmin();
      allow create: if dono(uid)
        && request.resource.data.get("papel", "usuario") == "usuario"
        && request.resource.data.get("bloqueado", false) == false;
      allow update: if superAdmin()
        || (dono(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["papel", "bloqueado", "criadoEm"]));
      allow delete: if superAdmin() || dono(uid); // "Excluir minha conta"

      match /dados/{nome} {
        allow read: if dono(uid) || superAdmin();
        allow create, update: if superAdmin() || (dono(uid) && naoBloqueado(uid));
        allow delete: if superAdmin() || dono(uid); // apagar os próprios dados vale mesmo com a conta bloqueada
      }
    }

    // Erros do site: quem está logado só cria (campos fixos e curtos, em nome próprio); só o super admin lê e apaga
    match /erros/{id} {
      allow create: if logado()
        && request.resource.data.keys().hasOnly(["tipo", "mensagem", "origem", "pagina", "navegador", "uid", "criadoEm"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tipo in ["js", "promessa", "ia"]
        && request.resource.data.mensagem is string && request.resource.data.mensagem.size() <= 500
        && request.resource.data.origem is string && request.resource.data.origem.size() <= 300
        && request.resource.data.pagina is string && request.resource.data.pagina.size() <= 200
        && request.resource.data.navegador is string && request.resource.data.navegador.size() <= 200
        && request.resource.data.criadoEm == request.time;
      allow read, delete: if superAdmin();
    }

    match /config/{doc} {
      allow read: if logado();
      allow write: if superAdmin();
    }
  }
}
